# Ghostty — installed to ~/.config/ghostty/config by bootstrap.sh
#
# On macOS Ghostty loads BOTH of these, and merges them:
#   ~/.config/ghostty/config                                  (XDG)
#   ~/Library/Application Support/com.mitchellh.ghostty/config (macOS)
# Settings had drifted across the two, which makes half the setup easy to lose
# in a machine move. Everything real lives here now; the macOS path is left to
# whatever template Ghostty generates.

theme = "Bluloco Dark"

# Claude Code multiline input. Normally installed by /terminal-setup, which
# writes it to the macOS-specific path — kept here so it travels with the theme.
keybind = shift+enter=text:\n

# Deliberately NOT setting font-family: Ghostty's default ships JetBrains Mono
# with Nerd Font symbol fallback, which is what makes the powerline status line
# and the starship prompt glyphs render. Set a font here only with a Nerd Font
# variant, or both will turn into tofu.
